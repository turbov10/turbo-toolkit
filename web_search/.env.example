# Copy to .env and fill in the keys for the engines you want to use.

# Google Custom Search JSON API
# - Create an API key: https://console.cloud.google.com/apis/credentials
# - Create a Custom Search Engine and copy its cx id:
#   https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CX=

# Bing Web Search API v7 (Azure)
# - Create a Bing Search resource and copy the subscription key:
#   https://portal.azure.com/  ->  "Bing Search v7"
BING_API_KEY=

# Gemini with Google Search grounding (no extra key beyond Gemini)
# - Get an API key: https://aistudio.google.com/apikey
# - Model override (default: gemini-2.5-flash). Must support google_search tool.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
