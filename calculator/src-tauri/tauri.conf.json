{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calculator",
  "version": "0.1.0",
  "identifier": "dev.turbo-toolkit.calculator",
  "build": {
    "beforeDevCommand": "pnpm build:h5",
    "devUrl": "http://localhost:10086",
    "beforeBuildCommand": "pnpm build:h5",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calculator",
        "width": 420,
        "height": 760,
        "minWidth": 320,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A modern cross-platform calculator",
    "longDescription": "A polished calculator that runs as a WeChat Mini Program, in the browser, and as a native macOS/Windows desktop application."
  }
}
